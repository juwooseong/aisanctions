                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[/* 업무일지 조회 (5030) - 차트2 데이터 */
/* TaskLogInquiryMapper.selectList */
WITH VW_TASK AS (
	SELECT	INPT_MST_SRNO, INPT_RCP_DT
			, TOTALTEXT_AI_INPT_RST_CD
			, ITM_INPT_AI_INPT_RST_CD
			, SAFEWATCH_AI_INPT_RST_CD
			, SUBSTRING(INPT_RCP_DT,1,6) AS INPT_RCP_YM
	FROM CSPD001TM
	WHERE AI_INPT_ACVT_CD IN ('160','140','130') /* 승인, Pending, Block */
	AND INPT_RCP_DT BETWEEN REPLACE(?,'-','') AND REPLACE(?,'-','')
)
SELECT	A.INPT_RCP_DT AS DAY, A.SF_CNT AS SW, A.IT_CNT AS HANG, A.TT_CNT AS TOT
FROM (
	SELECT	A.INPT_RCP_DT
			/* TotalText (170-자동심사결과상태 그룹코드,30-ALERT) */
			, NVL(SUM(CASE WHEN A.TOTALTEXT_AI_INPT_RST_CD = '30' THEN 1 ELSE 0 END),0) AS TT_CNT		
			/* 항목심사 (170-자동심사결과상태 그룹코드,30-ALERT) */
			, NVL(SUM(CASE WHEN A.ITM_INPT_AI_INPT_RST_CD = '30' THEN 1 ELSE 0 END),0) AS IT_CNT
			/* SafeWatch (170-자동심사결과상태 그룹코드,30-ALERT) */
			, NVL(SUM(CASE WHEN A.SAFEWATCH_AI_INPT_RST_CD = '30' THEN 1 ELSE 0 END),0) AS SF_CNT
	FROM VW_TASK A
	GROUP BY A.INPT_RCP_DT
) A
]]></xml-property>
