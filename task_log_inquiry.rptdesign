            </list-property>
            <xml-property name="queryText"><![CDATA[/* 업무일지 - 업무일지 등록 (5020) */
/* TaskLogRegMapper.select3List */
/* 3. 수/발신 전문심사 (SafeWatch) */
WITH VW_LIST AS (
	SELECT	A.*
	FROM CSPD010TA A
	WHERE A.AI_INPT_APDR_DT BETWEEN REPLACE(?,'-','') AND REPLACE(?,'-','')
	AND A.AI_INPT_APDR_DSCD = '03'
), VW_STAT AS (
	SELECT	A.*
			, (A.COL1 + A.COL2) AS COL3										/* 합계 */
	FROM (
		SELECT	A.AI_INPT_APDR_ITCD
				, NVL(SUM(A.COL1),0) AS COL1
				, NVL(SUM(A.COL2),0) AS COL2
		FROM (
			SELECT	A.AI_INPT_APDR_ITCD
					, A.AI_INPT_RMSG_CNT AS COL1								/* 수신전문 */
					, A.AI_INPT_SMSG_CNT AS COL2								/* 발신전문 */
			FROM VW_LIST A
		) A
		GROUP BY A.AI_INPT_APDR_ITCD
	) A
)
SELECT	CASE A.AI_INPT_APDR_ITCD
			WHEN '14' THEN '정보발생전문건수'
			WHEN '10' THEN 'SafeWatch'
			WHEN '13' THEN '위반(의심)거래 거절'
			ELSE '' END AS TITLE
		, A.COL1
		, A.COL2
		, A.COL3
FROM	(
	SELECT	CASE A.AI_INPT_APDR_ITCD 
				WHEN '14' THEN 1													/* 323-14 : 정보발생전문건수 */
				WHEN '10' THEN 2													/* 323-10 : SafeWatch */
				WHEN '13' THEN 3													/* 323-13 : 위반(의심)거래 거절 */
				ELSE 0 END AS RN
			, A.*
	FROM	VW_STAT A
) A
ORDER BY A.RN ASC
]]></xml-property>
