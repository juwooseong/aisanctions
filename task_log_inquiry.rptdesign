            <xml-property name="queryText"><![CDATA[/* 업무일지 - 업무일지 등록 (5020) */
/* TaskLogRegMapper.select4List */
/* 4. 서류심사건 자체점검 (Quality Assurance) */
WITH VW_LIST AS (
	/* 건수저장 테이블 목록 */
	SELECT	A.*
	FROM CSPD010TA A
	WHERE A.AI_INPT_APDR_DT BETWEEN REPLACE(?,'-','') AND REPLACE(?,'-','')
	AND A.AI_INPT_APDR_DSCD = '04'
), VW_QA_TASK AS (
	/* QA심사작업목록 - 검색일자 */
	SELECT	INPT_MST_SRNO, QLT_GRN_AI_INPT_RST_CD, AI_INPT_QLAS_ACVT_CD
			, INPT_ATMC_BIZ_DSCD, AI_INPT_QLAS_PROS_CD
	FROM CSPD001TM
	WHERE INPT_RCP_DT BETWEEN REPLACE(?,'-','') AND REPLACE(?,'-','')
	AND AI_INPT_QLAS_ACVT_CD IN (110,120,130,140,150)
), VW_STAT AS (
	/* 통계목록 */
	SELECT	A.*
			, (A.COL1 + A.COL2 + A.COL3 + A.COL4) AS COL5					/* 합계 */
	FROM (
		SELECT	A.AI_INPT_APDR_ITCD
				, NVL(SUM(A.COL1),0) AS COL1
				, NVL(SUM(A.COL2),0) AS COL2
				, NVL(SUM(A.COL3),0) AS COL3
				, NVL(SUM(A.COL4),0) AS COL4
		FROM (
			SELECT	A.AI_INPT_APDR_ITCD, B.COL1, B.COL2, A.COL3, A.COL4
			FROM (
				/* 건수저장 테이블에서 세번째 컬럼과 네번째 컬럼 가져옴 */
				SELECT	A.AI_INPT_APDR_ITCD
						, A.AI_INPT_TBK_ISSU_CNT AS COL3							/* 당발 */
						, A.AI_INPT_OBK_ISSU_CNT AS COL4							/* 타발 */
				FROM VW_LIST A
			) A
			INNER JOIN (
				/* 심사 테이블에서 첫번째 컬럼과 두번째 컬럼 가져옴 */
				
				/* FullText - CSPD001TM.AI_INPT_QLAS_PROS_CD, 280-3, 자체점검(QA)-TotalText */
				SELECT '15' AS AI_INPT_APDR_ITCD, A.*
				FROM (
					SELECT DISTINCT
						NVL(SUM(CASE WHEN A.AI_INPT_QLAS_PROS_CD = '3' AND 
							A.INPT_ATMC_BIZ_DSCD = '2' THEN 1 ELSE 0 END),0) AS COL1				/* 수출 */
						, NVL(SUM(CASE WHEN A.AI_INPT_QLAS_PROS_CD = '3' AND 
							A.INPT_ATMC_BIZ_DSCD = '1' THEN 1 ELSE 0 END),0) AS COL2				/* 수입 */
					FROM VW_QA_TASK A
				) A
				
				UNION ALL
				/* 항목별심사 - CSPD001TM.AI_INPT_QLAS_PROS_CD, 280-4, 자체점검(QA)-항목심사 */
				SELECT '16' AS AI_INPT_APDR_ITCD, A.*
				FROM (
					SELECT DISTINCT
						NVL(SUM(CASE WHEN A.AI_INPT_QLAS_PROS_CD = '4' AND 
							A.INPT_ATMC_BIZ_DSCD = '2' THEN 1 ELSE 0 END),0) AS COL1				/* 수출 */
						, NVL(SUM(CASE WHEN A.AI_INPT_QLAS_PROS_CD = '4' AND 
							A.INPT_ATMC_BIZ_DSCD = '1' THEN 1 ELSE 0 END),0) AS COL2				/* 수입 */
					FROM VW_QA_TASK A
				) A
	
				UNION ALL
				/* SafeWatch - CSPD001TM.AI_INPT_QLAS_PROS_CD, 280-5, 자체점검(QA)-SafeWatch */
				SELECT '10' AS AI_INPT_APDR_ITCD, A.*
				FROM (
					SELECT DISTINCT
						NVL(SUM(CASE WHEN A.AI_INPT_QLAS_PROS_CD = '5' AND 
							A.INPT_ATMC_BIZ_DSCD = '2' THEN 1 ELSE 0 END),0) AS COL1				/* 수출 */
						, NVL(SUM(CASE WHEN A.AI_INPT_QLAS_PROS_CD = '5' AND 
							A.INPT_ATMC_BIZ_DSCD = '1' THEN 1 ELSE 0 END),0) AS COL2				/* 수입 */
					FROM VW_QA_TASK A
				) A
	
				UNION ALL
				/* 적정 */
				SELECT '17' AS AI_INPT_APDR_ITCD, A.*
				FROM (
					SELECT DISTINCT
						NVL(SUM(CASE WHEN A.QLT_GRN_AI_INPT_RST_CD = '10' AND 
							A.INPT_ATMC_BIZ_DSCD = '2' THEN 1 ELSE 0 END),0) AS COL1				/* 수출 */
						, NVL(SUM(CASE WHEN A.QLT_GRN_AI_INPT_RST_CD = '10' AND 
							A.INPT_ATMC_BIZ_DSCD = '1' THEN 1 ELSE 0 END),0) AS COL2				/* 수입 */
					FROM VW_QA_TASK A
				) A
	
				UNION ALL
				/* 비적정 */
				SELECT '18' AS AI_INPT_APDR_ITCD, A.*
				FROM (
					SELECT DISTINCT
						NVL(SUM(CASE WHEN A.QLT_GRN_AI_INPT_RST_CD = '20' AND 
							A.INPT_ATMC_BIZ_DSCD = '2' THEN 1 ELSE 0 END),0) AS COL1				/* 수출 */
						, NVL(SUM(CASE WHEN A.QLT_GRN_AI_INPT_RST_CD = '20' AND 
							A.INPT_ATMC_BIZ_DSCD = '1' THEN 1 ELSE 0 END),0) AS COL2				/* 수입 */
					FROM VW_QA_TASK A
				) A
	
			) B ON A.AI_INPT_APDR_ITCD = B.AI_INPT_APDR_ITCD
		) A
		GROUP BY A.AI_INPT_APDR_ITCD
	) A
)
SELECT	A.TITLE
		, A.COL1, A.COL2, A.COL3
		, A.COL4, A.COL5
FROM	(
	SELECT	A.*
			, CASE A.AI_INPT_APDR_ITCD
				WHEN '15' THEN 1													/* 323-15 : FullText */
				WHEN '16' THEN 2													/* 323-16 : 항목별심사 */
				WHEN '10' THEN 3													/* 323-10 : SafeWatch */
				WHEN '17' THEN 4													/* 323-17 : 적정 */
				WHEN '18' THEN 5													/* 323-18 : 비적정 */
				ELSE 0 END AS RN
			, CASE A.AI_INPT_APDR_ITCD
				WHEN '15' THEN 'FullText'											/* 323-15 : FullText */
				WHEN '16' THEN '항목별심사'												/* 323-16 : 항목별심사 */
				WHEN '10' THEN 'SafeWatch'											/* 323-10 : SafeWatch */
				WHEN '17' THEN '적정'													/* 323-17 : 적정 */
				WHEN '18' THEN '비적정'												/* 323-18 : 비적정 */
				ELSE NULL END AS TITLE
	FROM	VW_STAT A
) A
ORDER BY A.RN ASC]]></xml-property>
