            </list-property>
            <xml-property name="queryText"><![CDATA[/* 업무일지 조회 (5030) - 차트1 데이터 */
/* TaskLogInquiryMapper.selectList */
WITH VW_TASK AS (
	SELECT	INPT_ATMC_BIZ_DSCD, INPT_MST_SRNO, INPT_RCP_DT
			, SUBSTRING(INPT_RCP_DT,1,6) AS INPT_RCP_YM
	FROM CSPD001TM
	WHERE INPT_RCP_DT BETWEEN REPLACE(?,'-','') AND REPLACE(?,'-','')
)
SELECT	A.INPT_RCP_DT AS DAY, A.EXP_CNT AS EXPORT, A.IMP_CNT AS IMPORT
FROM (
	SELECT	A.INPT_RCP_DT
			, NVL(SUM(CASE WHEN A.INPT_ATMC_BIZ_DSCD = '1' THEN 1 ELSE 0 END),0) AS IMP_CNT
			, NVL(SUM(CASE WHEN A.INPT_ATMC_BIZ_DSCD = '2' THEN 1 ELSE 0 END),0) AS EXP_CNT
	FROM VW_TASK A
	GROUP BY A.INPT_RCP_DT
) A]]></xml-property>
