                <structure>
                    <property name="position">1</property>
                    <property name="name">DAY</property>
                    <property name="nativeName">DAY</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">EXPORT</property>
                    <property name="nativeName">EXPORT</property>
                    <property name="dataType">decimal</property>
                    <property name="nativeDataType">2</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">IMPORT</property>
                    <property name="nativeName">IMPORT</property>
