            <xml-property name="queryText"><![CDATA[/* 업무일지 - 업무일지 등록 (5020) */
/* TaskLogRegMapper.select5List */
/* 5. 기타 */
WITH VW_LIST AS (
	SELECT	A.*
	FROM CSPD010TA A
	WHERE A.AI_INPT_APDR_DT BETWEEN REPLACE(?,'-','') AND REPLACE(?,'-','')
	AND A.AI_INPT_APDR_DSCD = '05'
), VW_STAT AS (
	SELECT	A.AI_INPT_APDR_ITCD
			, A.AI_INPT_ETC_OPI_TXT AS COL1								/* 기타 */
			, A.AI_INPT_APDR_DT AS COL2
	FROM	VW_LIST A
)
SELECT	A.COL1
		, TO_CHAR(TO_DATE(A.COL2,'YYYYMMDD'),'YYYY-MM-DD') AS COL2
FROM	VW_STAT A
ORDER BY A.COL2 DESC
]]></xml-property>
