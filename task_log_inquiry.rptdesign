                </structure>
                <structure>
                    <property name="position">6</property>
                    <property name="name">COL5</property>
                    <property name="nativeName">COL5</property>
                    <property name="dataType">decimal</property>
                    <property name="nativeDataType">2</property>
                </structure>
                <structure>
                    <property name="position">7</property>
                    <property name="name">COL6</property>
                    <property name="nativeName">COL6</property>
                    <property name="dataType">decimal</property>
                    <property name="nativeDataType">2</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[/* 업무일지 - 업무일지 등록 (5020) */
/* TaskLogRegMapper.select2List */
/* 2. W/F 실행건 증빙서류 심사 */
WITH VW_LIST AS (
	SELECT	A.*
	FROM CSPD010TA A
	WHERE A.AI_INPT_APDR_DT BETWEEN REPLACE(?,'-','') AND REPLACE(?,'-','')
	AND A.AI_INPT_APDR_DSCD = '02'
), VW_STAT AS (
	/* 통계 목록 */
	SELECT	A.*
			, (A.COL1 + A.COL2 + A.COL3 + A.COL4 + A.COL5) AS COL6			/* 합계 */
	FROM (
		SELECT	A.AI_INPT_APDR_ITCD
				, NVL(SUM(A.COL1),0) AS COL1
				, NVL(SUM(A.COL2),0) AS COL2
				, NVL(SUM(A.COL3),0) AS COL3
				, NVL(SUM(A.COL4),0) AS COL4
				, NVL(SUM(A.COL5),0) AS COL5
		FROM (
			SELECT	A.AI_INPT_APDR_ITCD
					, A.AI_INPT_XPO_REL_CNT AS COL1								/* 수출 */
					, A.AI_INPT_IMP_REL_CNT AS COL2								/* 수입 */
					, A.AI_INPT_TBK_ISSU_CNT AS COL3							/* 당발 */
					, A.AI_INPT_OBK_ISSU_CNT AS COL4							/* 타발 */
					, A.AI_INPT_ETC_ITM_CNT AS COL5								/* 기타 */
			FROM VW_LIST A
		) A
		GROUP BY A.AI_INPT_APDR_ITCD
	) A
)
SELECT	A.TITLE
		, NVL(B.COL1,0) AS COL1
		, NVL(B.COL2,0) AS COL2
		, NVL(B.COL3,0) AS COL3
		, NVL(B.COL4,0) AS COL4
		, NVL(B.COL5,0) AS COL5
		, NVL(B.COL6,0) AS COL6
FROM	(
	SELECT '11' AS AI_INPT_APDR_ITCD, '필터링등록' AS TITLE FROM DUAL
	UNION ALL
	SELECT '12' AS AI_INPT_APDR_ITCD, '문면심사' AS TITLE FROM DUAL
	UNION ALL
	SELECT '10' AS AI_INPT_APDR_ITCD, 'SafeWatch' AS TITLE FROM DUAL
	UNION ALL
	SELECT '13' AS AI_INPT_APDR_ITCD, '위반(의심)거래 거절' AS TITLE FROM DUAL
) A, (
	SELECT	A.*
			, CASE A.AI_INPT_APDR_ITCD 
			WHEN '11' THEN 1													/* 323-11 : 필터링등록 */
			WHEN '12' THEN 2													/* 323-12 : 문면심사 */
			WHEN '10' THEN 3													/* 323-10 : SafeWatch */
			WHEN '13' THEN 4													/* 323-13 : 위반(의심)거래 거절 */
			ELSE 0 END AS RN
	FROM VW_STAT A
) B
WHERE A.AI_INPT_APDR_ITCD = B.AI_INPT_APDR_ITCD(+)
ORDER BY B.RN ASC
]]></xml-property>
