# 환경 변수 예시 — 복사 후 실제 값으로 수정
#   cp env.example env.local && . ./env.local

# 프로젝트/빌드
export AISANCTION_BUILD_HOME="${AISANCTION_BUILD_HOME:-/home/aisac/build/aisanction}"
export AISANCTION_TARGET_EXPLODED="${AISANCTION_TARGET_EXPLODED:-/home/aisac/build/aisanction/target/aisanction-1.0.0}"
export AISANCTION_APPS="${AISANCTION_APPS:-/home/aisac/apps}"
export AISANCTION_BACKUP="${AISANCTION_BACKUP:-/home/aisac/backup}"
export AISANCTION_LOG_DIR="${AISANCTION_LOG_DIR:-/home/aisac/build/log}"

# JDK (서버 실제 경로로 변경)
export JAVA_HOME="${JAVA_HOME:-/usr/lib/jvm/java-1.8.0-openjdk}"

# Maven -Denv : d | p
export MVN_DENV="${MVN_DENV:-d}"

# JEUS
export JEUS_SCRIPT_DIR="${JEUS_SCRIPT_DIR:-/jeus/jeus8/SCRIPT}"
# hostname 별 기본값: wretaap1d→aisanction, wretaap1p→aisanction11, wretaap2p→aisanction21
export JEUS_INSTANCE="${JEUS_INSTANCE:-}"

# BIRT (미사용 시 비움)
export BIRT_REPORT_SRC="${BIRT_REPORT_SRC:-/home/aisac/build/birt/report}"
export BIRT_LAYOUT_SRC="${BIRT_LAYOUT_SRC:-/home/aisac/build/birt/layout}"
export BIRT_STYLES_SRC="${BIRT_STYLES_SRC:-/home/aisac/build/birt/styles}"
export BIRT_REPORT_DST="${BIRT_REPORT_DST:-/home/aisac/birt/report}"
export BIRT_LAYOUT_DST="${BIRT_LAYOUT_DST:-/home/aisac/birt/webcontent/birt/pages/layout}"
export BIRT_STYLES_DST="${BIRT_STYLES_DST:-/home/aisac/apps/birt/webcontent/birt/styles}"
