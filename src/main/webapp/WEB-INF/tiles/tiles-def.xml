<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE tiles-definitions PUBLIC "-//Apache Software Foundation//DTD Tiles Configuration 3.0//EN" "http://tiles.apache.org/dtds/tiles-config_3_0.dtd">
<tiles-definitions>
	<definition name="fullLayout"
		template="/WEB-INF/jsp/layout/fulllayout.jsp">
		<put-attribute name="header"
			value="/WEB-INF/jsp/layout/header.jsp" />
		<put-attribute name="contents"
			value="/WEB-INF/jsp/layout/contents.jsp" />
		<put-attribute name="footer"
			value="/WEB-INF/jsp/layout/footer.jsp" />
	</definition>
	<definition name="frameLayout"
		template="/WEB-INF/jsp/layout/frameLayout.jsp">
		<put-attribute name="contents"
			value="/WEB-INF/jsp/layout/contents.jsp" />
	</definition>
	<definition name="blankLayout"
		template="/WEB-INF/jsp/layout/blankLayout.jsp">
		<put-attribute name="contents"
			value="/WEB-INF/jsp/layout/contents.jsp" />
	</definition>
	<definition name="layout"
		template="/WEB-INF/jsp/layout/layout.jsp">
		<put-attribute name="header"
			value="/WEB-INF/jsp/layout/header.jsp" />
		<put-attribute name="aside"
			value="/WEB-INF/jsp/layout/aside.jsp" />
		<put-attribute name="contents"
			value="/WEB-INF/jsp/layout/contents.jsp" />
		<put-attribute name="footer"
			value="/WEB-INF/jsp/layout/footer.jsp" />
	</definition>
	<definition name="fortab"
		template="/WEB-INF/jsp/layout/tab_layout.jsp">
		<put-attribute name="header"
			value="/WEB-INF/jsp/layout/contents.jsp" />
	</definition>
	
	<definition name="full/*/*" extends="fullLayout">
		<put-attribute name="contents"
			value="/WEB-INF/jsp/{1}/{2}.jsp" />
	</definition>
	<definition name="full/*/*/*" extends="fullLayout">
		<put-attribute name="contents"
			value="/WEB-INF/jsp/{1}/{2}/{3}.jsp" />
	</definition>
	<definition name="full/*/*/*/*" extends="fullLayout">
		<put-attribute name="contents"
			value="/WEB-INF/jsp/{1}/{2}/{3}/{4}.jsp" />
	</definition>

	<definition name="blank/common/*" extends="blankLayout">
		<put-attribute name="contents"
			value="/WEB-INF/jsp/common/{1}.jsp" />
	</definition>
	<definition name="blank/*/*" extends="frameLayout">
		<put-attribute name="contents"
			value="/WEB-INF/jsp/{1}/{2}.jsp" />
	</definition>
	<definition name="blank/*/*/*" extends="frameLayout">
		<put-attribute name="contents"
			value="/WEB-INF/jsp/{1}/{2}/{3}.jsp" />
	</definition>
	<definition name="blank/*/*/*/*" extends="frameLayout">
		<put-attribute name="contents"
			value="/WEB-INF/jsp/{1}/{2}/{3}/{4}.jsp" />
	</definition>

	<definition name="tab/*/*" extends="fortab">
		<put-attribute name="contents"
			value="/WEB-INF/jsp/{1}/{2}.jsp" />
	</definition>
	<definition name="tab/*/*/*" extends="fortab">
		<put-attribute name="contents"
			value="/WEB-INF/jsp/{1}/{2}/{3}.jsp" />
	</definition>
	<definition name="tab/*/*/*/*" extends="fortab">
		<put-attribute name="contents"
			value="/WEB-INF/jsp/{1}/{2}/{3}/{4}.jsp" />
	</definition>

	<definition name="*/*/*/*" extends="layout">
		<put-attribute name="contents"
			value="/WEB-INF/jsp/{1}/{2}/{3}/{4}.jsp" />
	</definition>
	<definition name="*/*/*" extends="layout">
		<put-attribute name="contents"
			value="/WEB-INF/jsp/{1}/{2}/{3}.jsp" />
	</definition>
	<definition name="*/*" extends="layout">
		<put-attribute name="contents"
			value="/WEB-INF/jsp/{1}/{2}.jsp" />
	</definition>
</tiles-definitions>